{
  "name": "pos-restaurante",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/desktop",
    "apps/web",
    "apps/cloud-api",
    "packages/*"
  ],
  "scripts": {
    "desktop:dev": "npm run tauri dev --workspace apps/desktop",
