# Respaldo a servidor (opcional) -- ver shared/sync/supabaseClient.ts.
# Sin estas 3 variables la app funciona exactamente igual, 100% local/offline.
#
# Cómo obtenerlas:
# 1. Crea un proyecto gratis en https://supabase.com
# 2. Corre apps/web/supabase/schema.sql en el SQL Editor de ese proyecto
#    (reemplazando antes el texto CAMBIA_ESTE_SECRETO_LARGO_Y_UNICO por el
#    mismo valor que pongas aquí abajo en VITE_SYNC_SECRET)
# 3. Crea un bucket de Storage llamado "images" (privado)
# 4. Copia estos 3 valores desde Project Settings > API
#
# Para producción (Netlify): Site settings > Environment variables -- nunca
# subas un archivo .env.local real a git (ya está en .gitignore).

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
VITE_SYNC_SECRET=el-mismo-secreto-que-pusiste-en-schema.sql
